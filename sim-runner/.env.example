# ── Server ───────────────────────────────────────────────────────
PORT=3000

# Secret that protects all /api/run and /api/results endpoints
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SIM_SECRET=your_secret_here

# ── TraydBook ─────────────────────────────────────────────────────
TB_APP_URL=https://dev.traydbook.com
TB_SB_URL=https://YOUR_PROJECT.supabase.co
TB_SB_ANON_KEY=your_anon_key
TB_SB_SERVICE_KEY=your_service_role_key

# ── Wallet Buddy Portal ───────────────────────────────────────────
WB_APP_URL=https://wallet-buddy.yourdomain.com

